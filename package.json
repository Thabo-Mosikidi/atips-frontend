{
  "name": "atips-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:push:dev": "cross-env DOTENV_CONFIG_PATH=.env.development node -r dotenv/config ./node_modules/prisma/build/index.js db push",
    "db:push:staging": "cross-env DOTENV_CONFIG_PATH=.env.staging node -r dotenv/config ./node_modules/prisma/build/index.js db push",
    "db:seed": "prisma db seed",
    "db:seed:dev": "cross-env DOTENV_CONFIG_PATH=.env.development node -r dotenv/config ./node_modules/ts-node/dist/bin.js prisma/seed.ts",
    "db:seed:staging": "cross-env DOTENV_CONFIG_PATH=.env.staging node -r dotenv/config ./node_modules/ts-node/dist/bin.js prisma/seed.ts"
  },
  "dependencies": {
    "@paypal/react-paypal-js": "^9.1.1",
    "@prisma/client": "^6.19.2",
    "@vercel/analytics": "^2.0.1",
    "dotenv": "^17.3.1",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "stripe": "^20.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/estree": "^1.0.8",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^20.19.35",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.27",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "postcss": "^8.5.6",
    "prisma": "^6.19.2",
    "tailwindcss": "^4.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
